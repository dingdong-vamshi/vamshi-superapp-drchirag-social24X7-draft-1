{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), display-capture=(self)"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/store/:slug/product/:productSlug",
      "destination": "/store/[slug]/product/[productSlug]"
    },
    {
      "source": "/store/:slug",
      "destination": "/store/[slug]"
    },
    {
      "source": "/business-chat/:id",
      "destination": "/business-chat/[id]"
    },
    {
      "source": "/commerce/order/:id",
      "destination": "/commerce/order/[id]"
    },
    {
      "source": "/games/:id",
      "destination": "/games/[id]"
    }
  ]
}
